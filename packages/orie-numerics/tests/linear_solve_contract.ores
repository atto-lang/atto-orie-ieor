// Expected: PASS:orie-linear-solve
import module linear_solve from "../src/linear_solve";
pub routine main(): void {
  let mut Array<f64> a = new Array<f64>();
  a.add(2.0); a.add(1.0); a.add(1.0); a.add(3.0);
  let mut Array<f64> b = new Array<f64>();
  b.add(8.0); b.add(13.0);
  val result = linear_solve.solve(rt borrow a, rt borrow b, 2);
  if result.is_err(); then stdio.stdout.println("FAIL:solve:admission"); return; fi
  val x = result.unwrap();
  if x.get(0) < 2.199999 || x.get(0) > 2.200001 ||
     x.get(1) < 3.599999 || x.get(1) > 3.600001; then
    stdio.stdout.println("FAIL:solve:result"); return;
  fi
  let mut Array<f64> singular = new Array<f64>();
  singular.add(1.0); singular.add(2.0);
  singular.add(2.0); singular.add(4.0);
  if linear_solve.solve(rt borrow singular, rt borrow b, 2).is_ok(); then
    stdio.stdout.println("FAIL:solve:singular"); return;
  fi
  stdio.stdout.println("PASS:orie-linear-solve");
}
