// Independent exhaustive tiny packing oracle in native Oreslang.
// Expected: PASS:orie-bnb-enumeration
import module branch_and_bound from "../src/branch_and_bound";
pub routine main(): void {
  let mut Array<f64> costs = new Array<f64>();
  costs.add(6.0); costs.add(5.0); costs.add(3.0);
  let mut Array<f64> weights = new Array<f64>();
  weights.add(4.0); weights.add(3.0); weights.add(2.0);
  let mut Array<f64> rhs = new Array<f64>();
  rhs.add(0.0);
  let mut Array<int> expected_integer = new Array<int>();
  expected_integer.add(0); expected_integer.add(0);
  expected_integer.add(3); expected_integer.add(5);
  expected_integer.add(6); expected_integer.add(8);
  expected_integer.add(9); expected_integer.add(11);
  // Explicit f64 RHS entries: no implicit int-to-f64 conversion.
  let mut Array<f64> capacities = new Array<f64>();
  capacities.add(0.0); capacities.add(1.0);
  capacities.add(2.0); capacities.add(3.0);
  capacities.add(4.0); capacities.add(5.0);
  capacities.add(6.0); capacities.add(7.0);
  for (let capacity = 0; capacity <= 7; capacity++) {
    rhs.set(0, capacities.get(capacity));
    let int enumerated = 0;
    for (let bits = 0; bits < 8; bits++) {
      // Decode three integer bits without the removed % operator.
      let int remaining = bits;
      let int x2 = 0;
      if remaining >= 4; then x2 = 1; remaining = remaining - 4; fi
      let int x1 = 0;
      if remaining >= 2; then x1 = 1; remaining = remaining - 2; fi
      val int x0 = remaining;
      val int weight = 4 * x0 + 3 * x1 + 2 * x2;
      val int objective = 6 * x0 + 5 * x1 + 3 * x2;
      if weight <= capacity && objective > enumerated; then
        enumerated = objective;
      fi
    }
    if enumerated != expected_integer.get(capacity); then
      stdio.stdout.println("FAIL:bnb:enumeration-reference"); return;
    fi
    val result = branch_and_bound.solve_binary(
      rt borrow costs, rt borrow weights, rt borrow rhs, 1, 128);
    if result.is_err(); then
      stdio.stdout.println("FAIL:bnb:admission"); return;
    fi
    val answer = result.unwrap();
    if answer.status != "optimal" ||
       answer.objective < enumerated - 0.000001 ||
       answer.objective > enumerated + 0.000001; then
      stdio.stdout.println("FAIL:bnb:enumeration"); return;
    fi
    val int weight = 4 * answer.values.get(0) +
        3 * answer.values.get(1) + 2 * answer.values.get(2);
    if weight > capacity; then
      stdio.stdout.println("FAIL:bnb:feasibility"); return;
    fi
  }
  stdio.stdout.println("PASS:orie-bnb-enumeration");
}
