// Expected: PASS:orie-simplex-status
// Unbounded canonical LP and pivot limit are not reported as optimal.
import module simplex from "../src/simplex";
pub routine main(): void {
  let mut Array<f64> c = new Array<f64>();
  c.add(1.0);
  let mut Array<f64> a = new Array<f64>();
  a.add(-1.0);
  let mut Array<f64> b = new Array<f64>();
  b.add(0.0);
  val unbounded = simplex.solve_max_leq(rt borrow c, rt borrow a,
                                       rt borrow b, 1, 5);
  if unbounded.is_err(); then stdio.stdout.println("FAIL:status:admit"); return; fi
  if unbounded.unwrap().status != "unbounded"; then
    stdio.stdout.println("FAIL:status:unbounded"); return;
  fi
  a.set(0, 1.0);
  b.set(0, 4.0);
  val limited = simplex.solve_max_leq(rt borrow c, rt borrow a,
                                     rt borrow b, 1, 1);
  if limited.is_err(); then stdio.stdout.println("FAIL:status:pivot"); return; fi
  // A one-pivot LP can finish exactly on the limit: status must not say
  // optimal until the following reduced-cost check is performed.
  if limited.unwrap().status != "pivot_limit"; then
    stdio.stdout.println("FAIL:status:pivot-limit"); return;
  fi
  stdio.stdout.println("PASS:orie-simplex-status");
}
