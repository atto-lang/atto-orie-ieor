// Independent 0/1 packing enumeration: optimum 9, with [1,0,1].
// LP relaxation reaches 9.5, so a genuine branch must occur.
// Expected: PASS:orie-branch-and-bound
import module branch_and_bound from "../src/branch_and_bound";
pub routine main(): void {
  let mut Array<f64> cost = new Array<f64>();
  cost.add(6.0); cost.add(5.0); cost.add(3.0);
  let mut Array<f64> a = new Array<f64>();
  a.add(4.0); a.add(3.0); a.add(2.0);
  let mut Array<f64> rhs = new Array<f64>();
  rhs.add(6.0);
  val result = branch_and_bound.solve_binary(
    rt borrow cost, rt borrow a, rt borrow rhs, 1, 128);
  if result.is_err(); then
    stdio.stdout.println("FAIL:bnb:admission"); return;
  fi
  val answer = result.unwrap();
  if answer.status != "optimal" ||
     answer.objective < 8.999999 || answer.objective > 9.000001 ||
     answer.values.get(0) != 1 ||
     answer.values.get(1) != 0 ||
     answer.values.get(2) != 1; then
    stdio.stdout.println("FAIL:bnb:oracle"); return;
  fi
  val partial = branch_and_bound.solve_binary(
    rt borrow cost, rt borrow a, rt borrow rhs, 1, 1);
  if partial.is_err(); then
    stdio.stdout.println("FAIL:bnb:budget"); return;
  fi
  if partial.unwrap().status != "node_limit"; then
    stdio.stdout.println("FAIL:bnb:misreported-optimality"); return;
  fi
  // 1.0 is infeasible under capacity 0.999999999: never report
  // "optimal" after rounding a tiny binary-boundary violation.
  let mut Array<f64> near_cost = new Array<f64>();
  let mut Array<f64> near_weights = new Array<f64>();
  let mut Array<f64> near_capacity = new Array<f64>();
  near_cost.add(1.0);
  near_weights.add(1.0);
  near_capacity.add(0.999999999);
  val boundary = branch_and_bound.solve_binary(
    rt borrow near_cost, rt borrow near_weights,
    rt borrow near_capacity, 1, 32);
  if boundary.is_ok(); then
    // A future exact solver may legitimately prove the zero optimum.
    // Conservatively returning Err is also acceptable for this prototype.
    val bounded = boundary.unwrap();
    if bounded.status != "optimal" || bounded.objective != 0.0 ||
       bounded.values.get(0) != 0; then
      stdio.stdout.println("FAIL:bnb:near-boundary-certificate"); return;
    fi
  fi
  stdio.stdout.println("PASS:orie-branch-and-bound");
}
